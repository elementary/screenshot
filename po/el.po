#: src/Application.vala:21
msgid "Screenshots"
msgstr "Στιγμιότυπα οθόνης"

#: src/Application.vala:33
msgid "Capture area"
msgstr "Περιοχή καταγραφής"

#: src/Application.vala:34
msgid "Capture the whole screen"
msgstr "Καταγραφή ολόκληρης της οθόνης"

#: src/Application.vala:35
msgid "Capture active window"
msgstr "Καταγραφή ενεργού παραθύρου"

#: src/Application.vala:36
msgid "Take screenshot after specified delay"
msgstr "Λήψη στιμιότυπου οθόνης μετά από προσδιορισμένη καθυστέρηση"

#: src/Application.vala:37
msgid "Seconds"
msgstr "Δευτερόλεπτα"

#: src/Application.vala:38
msgid "Include the pointer with the screenshot"
msgstr "Να συμπεριλαμβάνεται ο δείκτης στο στιγμιότυπο οθόνης"

#: src/Application.vala:39
msgid "Redact system text"
msgstr "Απόκρυψη κειμένου συστήματος"

#: src/Application.vala:40
msgid "Save screenshot to clipboard"
msgstr "Αποθήκευση στιγμιότυπου στο πρόχειρο"

#: src/Application.vala:208
msgid "Could not capture screenshot"
msgstr "Δεν είναι εφικτή η λήψη του στιγμιότυπου οθόνης"

#: src/Application.vala:209
msgid "Image not saved"
msgstr "Η απεικόνιση δεν αποθηκεύτηκε"

#: src/SaveDialog.vala:38
msgid "Screenshot"
msgstr "Στιγμιότυπο οθόνης"

#: src/SaveDialog.vala:79
msgid "Save Image as…"
msgstr "Αποθήκευση εικόνας ως…"

#. / TRANSLATORS: %s represents a timestamp here
#: src/SaveDialog.vala:84
#, c-format
msgid "Screenshot from %s"
msgstr "Στιγμιότυπο οθόνης από %s"

#: src/SaveDialog.vala:90
msgid "Name"
msgstr "Όνομα"

#: src/SaveDialog.vala:115
msgid "File Type"
msgstr "Τύπος αρχείου"

#: src/SaveDialog.vala:138
msgid "Folder"
msgstr "Φάκελος"

#: src/SaveDialog.vala:176
msgid "Copy to Clipboard"
msgstr "Αντιγραφή στο πρόχειρο"

#: src/SaveDialog.vala:178
msgid "Cancel"
msgstr "Ακύρωση"

#: src/SaveDialog.vala:180
msgid "Save"
msgstr "Αποθήκευση"

#: src/SaveDialog.vala:186
msgid "Filename can't be blank"
msgstr "Το όνομα αρχείου δεν μπορεί να είναι κενό"

#: src/SaveDialog.vala:189
msgid "Filename can't contain “/”"
msgstr "Το όνομα αρχείου δεν μπορεί να περιέχει «/»"

#: src/SaveDialog.vala:219
msgid "Select Screenshots Folder…"
msgstr "Επιλογή φακέλου στιγμιότυπων οθόνης…"

#: src/SaveDialog.vala:220
msgid "Select"
msgstr "Επιλογή"

